#!/bin/sh
# The mutastic gate, as Claude Code's and Codex's hooks run it: `gate open` on a prompt, `gate check`
# when the agent says it's done. Codex runs Claude Code's hooks as they are, with the same input and
# answers, so one script serves both; Codex has no CLAUDE_PROJECT_DIR, but runs a hook in the
# session's directory, which is the project.
#
# The plugin is on in every project, so this stays out of the way where the gate doesn't apply: not
# a git repository, or not a project mutastic reads. mutastic decides that, not this script, so a
# build mutastic learns to read is gated with no change here. Where it can't run, it says so and
# never blocks: a gate that can't check holds nothing.
#
#   gate open|check     with the hook's input on stdin
set -u

action=${1:-}
project=${CLAUDE_PROJECT_DIR:-$(pwd)}
mutastic=${MUTASTIC:-mutastic}

# A message for the person, from a Stop hook; nothing from a prompt's, where output is the agent's.
say() {
  if [ "$action" = check ]; then
    printf '{"systemMessage": "%s"}\n' "$1"
  fi
  exit 0
}

case "$action" in
  open | check) ;;
  *) echo "usage: gate open|check" >&2 && exit 2 ;;
esac

# The gate starts from a commit: outside git there's nothing to gate.
git -C "$project" rev-parse --verify -q HEAD >/dev/null 2>&1 || exit 0

if ! command -v "$mutastic" >/dev/null 2>&1; then
  # Without mutastic, nothing can say whether this is a project it reads. Say so only where it
  # plainly is one, rather than in every repository the agent opens.
  for build in pom.xml build.gradle build.gradle.kts settings.gradle settings.gradle.kts Cargo.toml; do
    [ -f "$project/$build" ] && break
    build=
  done
  [ -n "$build" ] || exit 0
  if [ "$action" = open ]; then
    echo "The mutastic plugin is on, but the mutastic command isn't installed, so this task isn't" \
      "gated. To install it: curl -fsSL https://mutastic.io/install.sh | sh"
  fi
  say "mutastic gate: the mutastic command isn't installed, so nothing was checked. To install it: curl -fsSL https://mutastic.io/install.sh | sh"
fi
if ! "$mutastic" gate "$action" --help >/dev/null 2>&1; then
  say "mutastic gate: this mutastic ($("$mutastic" --version 2>/dev/null)) has no gate: update it with curl -fsSL https://mutastic.io/install.sh | sh"
fi

# The hook's input is the command's too: it says which session this is. A mutastic that reads no
# build here says nothing and exits 0; one from before that says the directory "isn't a ... build"
# and exits 2, which is the same answer.
err=$(mktemp)
out=$("$mutastic" gate "$action" "$project" --hook=claude 2>"$err")
status=$?
grep -q "isn't a .* build" "$err" && notours=1 || notours=
rm -f "$err"
if [ $status -ne 0 ]; then
  [ -n "$notours" ] && exit 0
  say "mutastic gate: mutastic couldn't $action the gate here (exit $status), so nothing was checked. Run mutastic gate $action to see why."
fi
[ -n "$out" ] && printf '%s\n' "$out"
exit 0
